# =============================================================================
# RootLearn Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection settings
POSTGRES_USER=rootlearn
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=rootlearn
POSTGRES_PORT=5432

# Full database URL (used by backend)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://rootlearn:your_secure_postgres_password_here@postgres:5432/rootlearn

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Choose your AI provider: openai, anthropic, or gemini
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration (optional)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4096

# Google Gemini Configuration (optional)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=production

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# API configuration
API_V1_PREFIX=/api/v1
API_TITLE=RootLearn API
API_VERSION=1.0.0

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# Session creation limit (per user per hour)
RATE_LIMIT_SESSION_CREATION=20

# Tutor turns limit (per user per hour)
RATE_LIMIT_TUTOR_TURNS=120

# Teach-back evaluations limit (per user per hour)
RATE_LIMIT_TEACHBACK=40

# AI calls limit (per session total)
RATE_LIMIT_AI_PER_SESSION=30

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
SESSION_MAX_AGE=86400

# CSRF protection
CSRF_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Backend API URL (used by frontend)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching and rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# -----------------------------------------------------------------------------
# Nginx Configuration (Optional - if using nginx reverse proxy)
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Monitoring and Observability
# -----------------------------------------------------------------------------
# Enable performance monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Enable distributed tracing
ENABLE_TRACING=true
TRACING_SERVICE_NAME=rootlearn-backend

# Sentry configuration (optional - for error tracking)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# New Relic configuration (optional)
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key_here
NEW_RELIC_APP_NAME=RootLearn

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_TEACHBACK_ENABLED=true
FEATURE_GRAPH_VISUALIZATION=true
FEATURE_DIAGNOSTIC_ASSESSMENT=true

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Worker processes (for uvicorn)
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=60

# Max request size (MB)
MAX_REQUEST_SIZE=10
